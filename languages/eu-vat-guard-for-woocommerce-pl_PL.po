#: includes/class-vat-guard-admin.php:605
msgid "Enable if you're using WooCommerce's new block-based checkout"
msgstr "Włącz jeśli używasz nowej kasy blokowej WooCommerce"

#: includes/class-vat-guard-admin.php:611
