#: includes/class-vat-guard-admin.php:452
#: includes/class-vat-guard-admin.php:469
#: includes/class-vat-guard-admin.php:487
msgid "This string will be registered with WPML for translation."
msgstr "Esta cadena se registrará con WPML para traducción."

#: includes/class-vat-guard-admin.php:460
msgid "VAT Number Label"
msgstr "Etiqueta de Número de IVA"

#: includes/class-vat-guard-admin.php:465
#: includes/class-vat-guard-helper.php:152 includes/class-vat-guard.php:602
msgid "VAT Number"
msgstr "Número de IVA"

#: includes/class-vat-guard-admin.php:467
msgid "Custom label for the VAT number field. Leave empty to use default."
msgstr ""
"Etiqueta personalizada para el campo número de IVA. Dejar vacío para usar el "
"predeterminado."

#: includes/class-vat-guard-admin.php:477
msgid "VAT Exemption Message"
msgstr "Mensaje de Exención de IVA"

#: includes/class-vat-guard-admin.php:483
#: includes/class-vat-guard-helper.php:165
msgid "VAT exempt for this order"
msgstr "Exento de IVA para este pedido"

#: includes/class-vat-guard-admin.php:485
msgid ""
"Custom message shown when VAT exemption is applied. Leave empty to use "
"default."
msgstr ""
"Mensaje personalizado mostrado cuando se aplica la exención de IVA. Dejar "
"vacío para usar el predeterminado."

#: includes/class-vat-guard-admin.php:501
msgid "Disable VAT Exemption:"
msgstr "Deshabilitar Exención de IVA:"

#: includes/class-vat-guard-admin.php:502
msgid ""
"Useful if you only want to collect VAT numbers for record-keeping without "
"applying tax exemptions."
msgstr ""
"Útil si solo desea recopilar números de IVA para mantenimiento de registros "
"sin aplicar exenciones fiscales."

#: includes/class-vat-guard-admin.php:503
msgid "Fixed Prices Including VAT:"
msgstr "Precios Fijos Incluyendo IVA:"

#: includes/class-vat-guard-admin.php:504
msgid ""
"Prevents WooCommerce from adjusting prices based on customer location. All "
"customers see the same prices including VAT."
msgstr ""
"Evita que WooCommerce ajuste los precios según la ubicación del cliente. "
"Todos los clientes ven los mismos precios incluyendo IVA."

#: includes/class-vat-guard-admin.php:505
msgid "Custom Labels:"
msgstr "Etiquetas Personalizadas:"

#: includes/class-vat-guard-admin.php:506
msgid ""
"Override default field labels to match your store's terminology or language "
"preferences."
msgstr ""
"Anular las etiquetas de campo predeterminadas para coincidir con la "
"terminología o preferencias de idioma de su tienda."

#: includes/class-vat-guard-admin.php:507
msgid "Custom Messages:"
msgstr "Mensajes Personalizados:"

#: includes/class-vat-guard-admin.php:508
msgid "Customize the VAT exemption message shown to customers during checkout."
msgstr ""
"Personalizar el mensaje de exención de IVA mostrado a los clientes durante "
"el checkout."

#: includes/class-vat-guard-admin.php:509
msgid "WPML Compatibility:"
msgstr "Compatibilidad con WPML:"

