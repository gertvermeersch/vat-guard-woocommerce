#. Plugin Name of the plugin
#: vat-guard-woocommerce.php includes/class-vat-guard-admin.php:294
msgid "EU VAT Guard for WooCommerce"
msgstr "EU VAT Guard para WooCommerce"

#. Description of the plugin
#: vat-guard-woocommerce.php
msgid ""
"Manage EU VAT numbers and company information for WooCommerce customers and "
"B2B. Adds company and VAT fields to registration, account, and checkout, "
"exempts VAT (reverse charge) where applicable and provides admin tools for "
"VAT management."
msgstr ""
"Gestiona números de IVA de la UE e información de empresas para clientes de "
"WooCommerce y B2B. Añade campos de empresa e IVA al registro, cuenta y "
"checkout, exime del IVA (inversión del sujeto pasivo) cuando corresponda y "
"proporciona herramientas de administración para la gestión del IVA."

#. Author of the plugin
#: vat-guard-woocommerce.php
msgid "Stormlabs"
msgstr "Stormlabs"

#. Author URI of the plugin
#: vat-guard-woocommerce.php
msgid "https://stormlabs.be/"
msgstr "https://stormlabs.be/"

